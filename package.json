{
  "name": "critical",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "bun run --cwd apps/web e2e",
    "bench": "bun packages/engine/bench/schedule.bench.ts",
    "bench:node": "bun build packages/engine/bench/schedule.bench.ts --target=node --outfile=node_modules/.cache/schedule.bench.mjs && node node_modules/.cache/schedule.bench.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
