# Local dev talks to the local Supabase stack (`supabase start`).
# Copy to apps/web/.env.local. Values printed by `supabase status`.
# Never commit a real .env file.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=
# The /api functions that `npm run dev` serves need the secret key too.
SUPABASE_SECRET_KEY=

# 1 = Google, iCloud, maps and Gemini answer with invented data (only against the
# local Supabase). "Reconectar Google" then stays in the app; iCloud takes any
# Apple ID with an app password shaped like abcd-efgh-ijkl-mnop.
VITE_FAKE_PROVIDERS=1

# Local test account (SPEC §17), created by supabase/seed.sql on `supabase db reset`.
# The login screen shows an email form for it only in development.
#   email:    prueba@critical.test
#   password: prueba-critical-local
